# TMDB API key (v3 auth) - get a free one at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Turso database - create a free database at https://turso.tech
# `turso db show <db-name> --url` and `turso db tokens create <db-name>`
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Any long random string, used to sign login sessions (JWT)
JWT_SECRET=
